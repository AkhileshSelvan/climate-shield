# Copy to backend/.env and adjust. Never commit the real .env.

# PostgreSQL is the approved architecture. `docker compose up -d db` from the
# repository root starts one matching this URL.
DATABASE_URL=postgresql+psycopg2://climateshield:climateshield@localhost:5432/climateshield

# SQLite is supported for tests and quick local runs only:
# DATABASE_URL=sqlite:///./climateshield.db

# fixture (default, offline) | open-meteo (live, ingestion only)
WEATHER_PROVIDER=fixture

GRID_RESOLUTION_DEG=0.1
